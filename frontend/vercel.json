{
  "rootDirectory": "frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://usual-settings-britney-correspondence.trycloudflare.com/api/:path*"
    },
    {
      "source": "/**",
      "destination": "/index.html"
    }
  ]
}