{
  "buildCommand": "npm run build && node -e \"require('fs').copyFileSync('build/index.html','api/app.html')\"",
  "outputDirectory": "build",
  "routes": [
    { "src": "^/api/(.*)", "dest": "api/index.js" },
    { "src": "^/(index\\.html)?$", "dest": "api/spa.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "api/spa.js" }
  ]
}