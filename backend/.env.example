DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database: SQLite for quick local development (USE_SQLITE=1)
# Set USE_SQLITE=0 and configure PostgreSQL below for production.
USE_SQLITE=1
POSTGRES_DB=secure_vault
POSTGRES_USER=vault_user
POSTGRES_PASSWORD=vault_pass
DB_HOST=localhost
DB_PORT=5432

# Redis (optional in SQLite mode)
REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Encryption Master Key (Base64 encoded - 32 bytes)
# Generate with: python scripts/generate_key.py
DOCUMENT_ENCRYPTION_KEY=your-base64-encoded-encryption-key

# Email Settings (use console backend for local development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@securevault.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
